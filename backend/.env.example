# ==============================================================================
# YojnaSarthi Backend — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI (Helpdesk & Natural Language Profile Extraction)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 2. Administrative Security & Multi-Agent Scheme Intelligence
# ------------------------------------------------------------------------------
ADMIN_API_KEY=yojnasarthi-admin-secret-2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ENABLE_AUTOMATIC_MONITORING=true
MONITORING_INTERVAL_SECONDS=86400

# ------------------------------------------------------------------------------
# 3. myScheme / API Setu Integration
# Note: Keep false in deployment to run on verified local deterministic rules
# ------------------------------------------------------------------------------
ENABLE_MYSCHEME_INTEGRATION=false
MYSCHEME_API_ENABLED=false
MYSCHEME_API_BASE_URL=https://apisetu.gov.in/api/v1/myscheme
MYSCHEME_API_AUTH_MODE=api_key
MYSCHEME_API_KEY=
MYSCHEME_API_CLIENT_ID=
MYSCHEME_API_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 4. Performance & Caching Configuration
# ------------------------------------------------------------------------------
TRANSLATION_CACHE_TTL_SECONDS=86400
SCHEME_CACHE_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# 5. Cross-Origin Resource Sharing (CORS)
# In production, set this to your frontend domain (e.g. https://yojnasarthi.vercel.app)
# or '*' to allow all origins.
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

