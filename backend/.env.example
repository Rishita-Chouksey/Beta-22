# ==============================================================================
# YojnaSarthi Backend - Environment Variables Specification
# ==============================================================================

# ==============================================================================
# Microsoft Azure AI Translator Configuration
# ==============================================================================
# Official Azure Cognitive Services Translator API credentials.
# Supports English ('en'), Hindi ('hi'), and Bengali ('bn').
AZURE_TRANSLATOR_KEY=YOUR_AZURE_TRANSLATOR_KEY
AZURE_TRANSLATOR_REGION=YOUR_AZURE_TRANSLATOR_REGION
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# ==============================================================================
# Administrative Security & Monitoring
# ==============================================================================
ADMIN_API_KEY=yojnasarthi-admin-secret-2026
ENABLE_AUTOMATIC_MONITORING=true
MONITORING_INTERVAL_SECONDS=86400

# ==============================================================================
# Gemini AI API Configuration
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# myScheme / API Setu Integration Configuration
# ==============================================================================
ENABLE_MYSCHEME_INTEGRATION=false
MYSCHEME_API_ENABLED=false
MYSCHEME_API_BASE_URL=https://apisetu.gov.in/api/v1/myscheme
MYSCHEME_API_KEY=
MYSCHEME_API_CLIENT_ID=
MYSCHEME_API_CLIENT_SECRET=
MYSCHEME_API_AUTH_MODE=api_key

# ==============================================================================
# BHASHINI Official API Configuration
# ==============================================================================
ENABLE_BHASHINI_TRANSLATION=false
ENABLE_BHASHINI_ASR=false
ENABLE_BHASHINI_TTS=false
BHASHINI_API_ENABLED=false
BHASHINI_API_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
BHASHINI_INFERENCE_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_TRANSLATION_SERVICE_ID=
BHASHINI_ASR_SERVICE_ID=
BHASHINI_TTS_SERVICE_ID=

# ==============================================================================
# Caching Configuration
# ==============================================================================
TRANSLATION_CACHE_TTL_SECONDS=86400
SCHEME_CACHE_TTL_SECONDS=3600
