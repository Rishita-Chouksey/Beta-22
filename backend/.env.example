# Copy to backend/.env. Never commit backend/.env.
# Admin authentication is disabled until all three values below are set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=GENERATE_WITH_THE_COMMAND_IN_README
ADMIN_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_SESSION_TTL_SECONDS=1800
ADMIN_COOKIE_SAMESITE=strict

# Local HTTP development only. Set true behind HTTPS in production.
ADMIN_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Conservative daily monitoring; demo records stay disabled by default.
ENABLE_AUTOMATIC_MONITORING=true
MONITORING_INTERVAL_SECONDS=86400
ENABLE_MONITORING_DEMO_DATA=false

# Optional integrations. Neither discovery portal requires an API key.
GEMINI_API_KEY=
# Translation is offline (no key). Install models once: python -m scripts.install_translation_models
TRANSLATION_ENABLED=true
