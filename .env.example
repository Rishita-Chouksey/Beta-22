# ==============================================================================
# YojnaSarthi - Environment Variables Example
# ==============================================================================

# Gemini AI API Configuration
# Used for natural-language profile extraction, chatbot assistance, and form explanation
GEMINI_API_KEY=your_gemini_api_key_here

# BHASHINI API Configuration
# Used for official Indic language translation, speech-to-text, and text-to-speech
# Note: If unconfigured, the application gracefully activates native browser Web Speech API fallback!
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id_here

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Frontend Configuration (for frontend/.env)
# VITE_API_URL=http://localhost:8000/api
